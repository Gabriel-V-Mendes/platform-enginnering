# ===================================================
# Variáveis de Ambiente — IDP Platform Engineering
# ===================================================
# Copie este arquivo para .env e preencha os valores reais.
#   cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage

# ---------- GitHub ----------
# Token de acesso ao GitHub (necessário para Scaffolder e Entity Provider)
# Crie em: https://github.com/settings/tokens
# Tipo: Classic → Scopes necessários: repo, read:org, read:user, workflow
GITHUB_TOKEN=ghp_SEU_TOKEN_AQUI

# ---------- Kubernetes (opcional) ----------
# Descomente no app-config.production.yaml e no backend/src/index.ts para ativar
K8S_CLUSTER_URL=https://kubernetes.default.svc
K8S_SERVICE_ACCOUNT_TOKEN=
